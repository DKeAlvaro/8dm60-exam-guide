[Unit]
Description=8DM60 interactive exam guide
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/research/8dm60-exam-guide
EnvironmentFile=/etc/8dm60-guide.env
Environment=MKDOCS_BIN=/root/research/8dm60-exam-guide/.venv/bin/mkdocs
ExecStartPre=/bin/sh /root/pocket-vault-2/bin/cc-router-up
ExecStartPre=/root/research/8dm60-exam-guide/.venv/bin/mkdocs build --clean
ExecStart=/usr/bin/node /root/research/8dm60-exam-guide/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
